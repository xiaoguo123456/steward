# 服务器路径：/opt/steward-prod/.env.production

STEWARD_HTTP_ADDR=:8787
STEWARD_CORS_ORIGINS=https://steward.example.com
STEWARD_PUBLIC_BASE_URL=https://steward.example.com

# 同一 RDS 实例下使用生产环境专属账号。
STEWARD_DATABASE_URL=postgres://steward_p_app:URL_ENCODED_PASSWORD@RDS_PRIVATE_HOST:5432/steward_prod?sslmode=disable
STEWARD_MIGRATE_DATABASE_URL=postgres://steward_p_mig:URL_ENCODED_PASSWORD@RDS_PRIVATE_HOST:5432/steward_prod?sslmode=disable

STEWARD_JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_VALUE
STEWARD_ACCESS_TOKEN_TTL=2h
STEWARD_REFRESH_TOKEN_TTL=720h
STEWARD_TASK_LIST_ARCHIVE_RETENTION=72h
# 上线前由运维／法务确认，不能直接沿用示例值对外承诺。
STEWARD_ACCOUNT_DELETION_BACKUP_RETENTION=720h
STEWARD_SMS_PROVIDER=aliyun
STEWARD_DEV_SMS_CODE=
STEWARD_ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
STEWARD_ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_ME
STEWARD_ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_ME
STEWARD_ALIYUN_SMS_SIGN_NAME=REPLACE_ME
STEWARD_ALIYUN_SMS_TEMPLATE_CODE=REPLACE_ME
STEWARD_MEMORY_FINGERPRINT_KEY=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_VALUE

STEWARD_AI_PROVIDER=openai
STEWARD_AI_BASE_URL=https://api.acedata.cloud/openai
STEWARD_AI_API_KEY=REPLACE_ME
STEWARD_AI_MODEL_PARSE=gpt-5.6-luna
STEWARD_AI_MODEL_VISION=gpt-5.6-luna
STEWARD_AI_MODEL_CHAT=gpt-5.6-luna
STEWARD_AI_MODEL_TRANSCRIBE=whisper-1
STEWARD_AI_TIMEOUT=45s
STEWARD_AI_MAX_OUTPUT_TOKENS=2048

STEWARD_STREAM_DRIVER=redis
STEWARD_REDIS_URL=redis://default:URL_ENCODED_PASSWORD@REDIS_PRIVATE_HOST:6379/6
STEWARD_STREAM_NAMESPACE=steward-prod
STEWARD_STREAM_MAX_CONCURRENT=256

STEWARD_STORAGE_DRIVER=aliyun-oss
STEWARD_OSS_REGION=cn-beijing
# 签名 URL 会直接下发给客户端，必须使用公网 Endpoint。
STEWARD_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
STEWARD_OSS_BUCKET=REPLACE_WITH_SHARED_BUCKET
STEWARD_OSS_PREFIX=steward/prod
STEWARD_OSS_ACCESS_KEY_ID=REPLACE_ME
STEWARD_OSS_ACCESS_KEY_SECRET=REPLACE_ME

STEWARD_ADMIN_HTTP_ADDR=:8788
STEWARD_ADMIN_ALLOWED_ORIGINS=https://steward.example.com
STEWARD_ADMIN_DATABASE_URL=postgres://steward_p_admin:URL_ENCODED_PASSWORD@RDS_PRIVATE_HOST:5432/steward_prod?sslmode=disable
STEWARD_ADMIN_USERNAME=admin
STEWARD_ADMIN_PASSWORD_HASH='$argon2id$REPLACE_WITH_GENERATED_HASH'
STEWARD_ADMIN_CREDENTIAL_VERSION=1
STEWARD_ADMIN_SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_VALUE
STEWARD_ADMIN_CSRF_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_VALUE
STEWARD_ADMIN_IDLE_TIMEOUT=30m
STEWARD_ADMIN_ABSOLUTE_TIMEOUT=12h
STEWARD_ADMIN_REPORTING_TIMEZONE=Asia/Shanghai
STEWARD_ADMIN_COOKIE_SECURE=true
STEWARD_ENVIRONMENT=production
