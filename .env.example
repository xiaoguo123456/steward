# 本地开发环境变量示例。复制为 .env 后按需修改，.env 不进版本库。

# ---- HTTP API ----
STEWARD_HTTP_ADDR=:8787
# 允许跨域的来源，逗号分隔。Expo Web 预览默认使用 8081。
STEWARD_CORS_ORIGINS=http://localhost:8081,http://localhost:4174

# ---- 数据库 ----
# API 与 Worker 必须使用非超级用户的 steward_app 角色连接，否则 RLS 会被整体绕过：
# FORCE ROW LEVEL SECURITY 约束不到超级用户。该角色由迁移 00007 创建。
STEWARD_DATABASE_URL=postgres://steward_app:steward_dev_password@localhost:5432/steward_dev?sslmode=disable
STEWARD_TEST_DATABASE_URL=postgres://steward_app:steward_dev_password@localhost:5432/steward_test?sslmode=disable

# 迁移需要 DDL 权限，因此使用另一个具备建表权限的角色。
STEWARD_MIGRATE_DATABASE_URL=postgres://guo@localhost:5432/steward_dev?sslmode=disable

# ---- 鉴权 ----
# 生产环境必须替换为独立保管的强随机值，且 API 与 Worker 使用同一值。
STEWARD_JWT_SECRET=dev-only-insecure-secret-change-me
STEWARD_ACCESS_TOKEN_TTL=2h
STEWARD_REFRESH_TOKEN_TTL=720h

# 开发环境固定验证码，避免依赖真实短信通道。留空表示必须接入真实 Provider。
STEWARD_DEV_SMS_CODE=123456

# ---- AI Provider ----
# fake   使用确定性本地解析，不发起任何外部请求，用于离线开发与测试。
# openai 使用 OpenAI 官方 SDK，需要同时配置 API Key。
STEWARD_AI_PROVIDER=fake
STEWARD_OPENAI_API_KEY=
STEWARD_OPENAI_BASE_URL=

# ---- 对象存储 ----
# 本地默认写入文件系统；接入正式环境时替换为 S3 兼容配置。
STEWARD_STORAGE_DRIVER=filesystem
STEWARD_STORAGE_ROOT=./.local/storage
