# 本地开发环境变量示例。复制为 .env 后按需修改，.env 不进版本库。

# ---- HTTP API ----
STEWARD_HTTP_ADDR=:8787
# 允许跨域的来源，逗号分隔。Expo Web 预览默认使用 8081。
STEWARD_CORS_ORIGINS=http://localhost:8081,http://localhost:4174

# ---- 数据库 ----
# API 与 Worker 必须使用非超级用户的 steward_app 角色连接，否则 RLS 会被整体绕过：
# FORCE ROW LEVEL SECURITY 约束不到超级用户。该角色由迁移 00007 创建。
STEWARD_DATABASE_URL=postgres://steward_app:steward_dev_password@localhost:5432/steward_dev?sslmode=disable
STEWARD_TEST_DATABASE_URL=postgres://steward_app:steward_dev_password@localhost:5432/steward_test?sslmode=disable

# 迁移需要 DDL 权限，因此使用另一个具备建表权限的角色。
STEWARD_MIGRATE_DATABASE_URL=postgres://guo@localhost:5432/steward_dev?sslmode=disable

# ---- 鉴权 ----
# 生产环境必须替换为独立保管的强随机值，且 API 与 Worker 使用同一值。
STEWARD_JWT_SECRET=dev-only-insecure-secret-change-me
STEWARD_ACCESS_TOKEN_TTL=2h
STEWARD_REFRESH_TOKEN_TTL=720h
# 任务清单归档后的可恢复时长；API 与 Worker 必须保持一致。
STEWARD_TASK_LIST_ARCHIVE_RETENTION=72h
# 仅表示不可逐条修改的备份最晚自然过期边界；生产值须经运维与法务确认。
STEWARD_ACCOUNT_DELETION_BACKUP_RETENTION=720h

# dev 使用固定验证码；服务器环境使用 aliyun 并保持固定验证码为空。
STEWARD_SMS_PROVIDER=dev
STEWARD_DEV_SMS_CODE=123456
# 以下仅在 STEWARD_SMS_PROVIDER=aliyun 时需要。
STEWARD_ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
STEWARD_ALIYUN_SMS_ACCESS_KEY_ID=
STEWARD_ALIYUN_SMS_ACCESS_KEY_SECRET=
STEWARD_ALIYUN_SMS_SIGN_NAME=
STEWARD_ALIYUN_SMS_TEMPLATE_CODE=

# ---- AI Provider ----
# fake   确定性本地解析，不发起任何外部请求，仅用于 development/test；production 会拒绝启动。
# openai OpenAI 兼容的 Chat Completions 接口，需要同时配置 API Key 与 Base URL。
# 「不再学习这项」阻止记录的指纹密钥。独立用途，不要复用 JWT 密钥。
# 生成：openssl rand -hex 32
STEWARD_MEMORY_FINGERPRINT_KEY=dev-only-insecure-fingerprint-key-change-me

STEWARD_AI_PROVIDER=fake

# 阿里云百炼中国大陆版 OpenAI 兼容地址，不带结尾斜杠。
STEWARD_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 密钥只放在本地 .env，绝不入库。泄漏后请立即在服务商后台吊销并重新生成。
STEWARD_AI_API_KEY=
# 各用途使用的模型。业务代码只引用逻辑策略名，具体模型在这里配置。
STEWARD_AI_MODEL_PARSE=qwen3.7-plus
STEWARD_AI_MODEL_VISION=qwen-vl-plus
STEWARD_AI_MODEL_CHAT=qwen3.7-plus
STEWARD_AI_MODEL_TRANSCRIBE=qwen3-asr-flash
# 仅当 Provider 的敏感数据等级、处理地区、保留、训练退出与删除能力均已审核后设为 true。
# 默认 false 时，心情日记正文不会发送给 Provider，即使用户已在应用内单独同意。
STEWARD_AI_APPROVED_SENSITIVE_CONTENT=false
# 单次调用上限，超过即进入可重试失败，不使用 fake 冒充模型成功。
STEWARD_AI_TIMEOUT=45s
STEWARD_AI_MAX_OUTPUT_TOKENS=2048

# ---- 对象存储 ----
# localfs   落在本地磁盘，签名 URL 指向 API 自身，开发用，无需任何云凭证。
# aliyun-oss 阿里云 OSS。Bucket 必须是私有读写，不允许公共读。
# Turn 进度流（SSE）的传输。
#
# auto：配了 STEWARD_REDIS_URL 就用 Redis，否则退回 PostgreSQL LISTEN/NOTIFY。
# off：关掉进度流，客户端退回轮询——功能不受影响，只是没有逐字效果。
#
# 建议在有 Redis 的部署里用 Redis：LISTEN 是连接级状态，每条流会独占一个
# 数据库连接；PgBouncer 的 transaction 模式还会让 LISTEN/NOTIFY 彻底失效。
STEWARD_STREAM_DRIVER=auto
STEWARD_REDIS_URL=
# Redis 逻辑 DB 不隔离 Pub/Sub；共享实例时每个环境必须使用不同命名空间。
STEWARD_STREAM_NAMESPACE=steward-local
# 留空时按驱动取默认值：postgres 为 6，redis 为 256。
STEWARD_STREAM_MAX_CONCURRENT=

STEWARD_STORAGE_DRIVER=localfs
STEWARD_STORAGE_ROOT=./.local/storage
# localfs 生成签名 URL 时使用的对外地址。
STEWARD_PUBLIC_BASE_URL=http://localhost:8787

# 以下仅在 STEWARD_STORAGE_DRIVER=aliyun-oss 时需要。
STEWARD_OSS_REGION=cn-hangzhou
STEWARD_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
STEWARD_OSS_BUCKET=
# 同一 Bucket 复用时设置独立前缀，例如 steward/local。
STEWARD_OSS_PREFIX=steward/local
# AccessKey 只存在于服务端，绝不下发给客户端，也绝不入库。
STEWARD_OSS_ACCESS_KEY_ID=
STEWARD_OSS_ACCESS_KEY_SECRET=

# ---- 后台管理 ----
# 后台是独立进程、独立端口、独立数据库账号。
# 口令只存 Argon2id 散列，用 `go run ./cmd/admin-passwd` 生成。
STEWARD_ADMIN_HTTP_ADDR=:8788
STEWARD_ADMIN_ALLOWED_ORIGINS=http://localhost:8000
# 必须指向 steward_admin 角色，不要复用 steward_app。
STEWARD_ADMIN_DATABASE_URL=postgres://steward_admin:steward_admin_dev_password@localhost:5432/steward_dev?sslmode=disable
STEWARD_ADMIN_USERNAME=
STEWARD_ADMIN_PASSWORD_HASH=
# 改口令或轮换密钥后递增它，所有旧会话立刻失效。
STEWARD_ADMIN_CREDENTIAL_VERSION=1
# 两个密钥用途不同、轮换周期不同，不能相同。各至少 32 字符。
STEWARD_ADMIN_SESSION_SECRET=
STEWARD_ADMIN_CSRF_SECRET=
STEWARD_ADMIN_IDLE_TIMEOUT=30m
STEWARD_ADMIN_ABSOLUTE_TIMEOUT=12h
STEWARD_ADMIN_REPORTING_TIMEZONE=Asia/Shanghai
# 只有本地明文调试才设 false。
STEWARD_ADMIN_COOKIE_SECURE=true
STEWARD_ENVIRONMENT=development
