{
  "name": "ai-steward",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "mobile:start": "pnpm --filter mobile start",
    "mobile:live": "pnpm --filter mobile live",
    "mobile:web": "pnpm --filter mobile web",
    "mobile:lint": "pnpm --filter mobile lint",
    "mobile:preview": "pnpm --filter mobile preview:web",
    "mobile:test": "pnpm --filter mobile test:workouts",
    "mobile:typecheck": "pnpm --filter mobile typecheck",
    "contracts:bundle": "pnpm --filter @steward/contracts run bundle",
    "contracts:lint": "pnpm --filter @steward/contracts run lint",
    "client:generate": "pnpm --filter @steward/api-client run generate",
    "check": "pnpm mobile:lint && pnpm mobile:typecheck",
    "admin:dev": "pnpm --filter @steward/admin run dev",
    "admin:typecheck": "pnpm --filter @steward/admin run typecheck && pnpm --filter @steward/admin-api-client run typecheck",
    "admin:test": "pnpm --filter @steward/admin run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
