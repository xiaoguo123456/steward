{
  "expo": {
    "name": "序事",
    "slug": "ai-steward",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aisteward",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.aisteward.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#ECFBF3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在户外运动页面记录你的实时路线、距离和配速；暂停或离开页面后停止采集。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10B981",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 72
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "录下你说的话，转成文字后帮你整理成任务或日程。录音只用于这次整理。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "从相册选图，识别其中的文字帮你整理成任务、日程或账单。",
          "cameraPermission": "拍下小票或屏幕截图，识别其中的文字帮你整理。"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "使用面容识别解锁序事，避免任务、日记和草稿在你离开设备时被他人查看。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
