  "scripts": {
    "start": "expo start",
    "live": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-https://test-steward.qhzhiyin.com} expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "preview:web": "node scripts/serve-preview.mjs --host 0.0.0.0 --port 4174 --dir dist",
    "test": "pnpm run test:config && pnpm run test:important-dates && pnpm run test:review && pnpm run test:recipes && pnpm run test:trips && pnpm run test:workouts && pnpm run test:assistant && pnpm run test:calendar && pnpm run test:mood-journal && pnpm run test:notes && pnpm run test:plan && pnpm run test:trackers && pnpm run test:ui && pnpm run test:auth",
    "test:config": "node --experimental-strip-types --test app.config.test.mjs scripts/check-ota-safe-changes.test.mjs",
    "test:auth": "node --experimental-strip-types --test src/features/auth/phone-code.test.mjs src/features/auth/login-input.test.mjs src/features/account/account-navigation.test.mjs",
    "test:important-dates": "node --experimental-strip-types --test src/features/important-dates/important-date-picker.test.mjs",
    "test:notes": "node --experimental-strip-types --test src/features/notes/note-polish.test.mjs",
    "test:plan": "node --experimental-strip-types --test src/features/plan/anytime-task-actions.test.mjs src/features/plan/task-list-order.test.mjs src/features/plan/task-list-appearance.test.mjs src/features/plan/task-list-policy.test.mjs src/features/plan/plan-tab-navigation.test.mjs src/features/projects/project-task-scope.test.mjs src/features/tasks/manual-task-request.test.mjs",
    "test:review": "node --experimental-strip-types --test src/features/review/review-period.test.mjs src/features/review/review-metrics.test.mjs",
    "test:trackers": "node --experimental-strip-types --test src/features/trackers/trend-chart-model.test.mjs",
    "test:recipes": "node --experimental-strip-types --test src/features/recipes/discovery-order.test.mjs src/features/recipes/recipe-swap.test.mjs",
    "test:trips": "node --experimental-strip-types --test src/features/trips/trip-form.test.mjs",
    "test:ui": "node --experimental-strip-types --test src/components/ui/icon-system.test.mjs src/components/ui/filter-chip-system.test.mjs src/components/ui/tab-shell-compatibility.test.mjs src/features/home/home-top-navigation.test.mjs",
    "test:assistant": "node --experimental-strip-types --test src/features/assistant/assistant-markdown-policy.test.mjs src/features/assistant/assistant-media-capture.test.mjs src/features/assistant/assistant-thread-session.test.mjs",
    "test:calendar": "node --experimental-strip-types --test src/features/calendar/calendar-month.test.mjs",
    "test:mood-journal": "node --experimental-strip-types --test src/features/mood-journal/model.test.mjs",
    "test:workouts": "node --experimental-strip-types --test src/features/workouts/workout-location.test.mjs src/features/workouts/workout-voice.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web"
  },
  "private": true
}
