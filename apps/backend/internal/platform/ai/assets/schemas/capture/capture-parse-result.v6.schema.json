{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steward.local/ai-contracts/capture/capture-parse-result.v6.schema.json",
  "title": "Capture 解析结果 v6",
  "description": "v6 补齐新建打卡频率；保留完整字段与同批引用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "instruction_note": {
      "type": "string",
      "maxLength": 200,
      "description": "用户在输入中给出的限制条件，例如“只处理第一张”。必须在确认页醒目展示，不能被静默忽略。"
    },
    "relations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id"
      ],
      "properties": {
        "part_id": {
          "type": "string"
        },
        "text_start": {
          "type": "integer",
          "minimum": 0
        },
        "text_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "level"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "只用于排序与是否追问，永远不能用来跳过用户确认。"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    },
    "itineraryDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "booking_status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "transport",
            "lodging",
            "activity"
          ]
        },
        "transport_mode": {
          "type": "string",
          "enum": [
            "flight",
            "train",
            "coach",
            "ship",
            "self_drive",
            "other"
          ]
        },
        "origin": {
          "type": "string",
          "maxLength": 200
        },
        "destination": {
          "type": "string",
          "maxLength": 200
        },
        "service_number": {
          "type": "string",
          "maxLength": 50
        },
        "seat": {
          "type": "string",
          "maxLength": 100
        },
        "booking_status": {
          "type": "string",
          "enum": [
            "planned",
            "confirmed",
            "ticketed"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "action",
        "title",
        "sources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target_id",
              "target_expected_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tracker"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref",
              "tracker_fields"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tracker_id",
              "tracker_ref"
            ]
          }
        }
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "description": "本次输出内唯一的稳定引用，供 relations 的端点使用。"
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "event",
            "project",
            "note",
            "tracker",
            "record"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 5000
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "project_kind": {
          "type": "string",
          "enum": [
            "general",
            "trip"
          ]
        },
        "destination": {
          "type": "string",
          "maxLength": 100
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "description": "只有日期没有时刻的截止日；不得擅自补成当天 23:59。"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "list_id": {
          "type": "string",
          "minLength": 1,
          "description": "用户明确指定的已有任务清单稳定 ID；不得填写清单名称。"
        },
        "all_day": {
          "type": "boolean"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "event_kind": {
          "type": "string",
          "enum": [
            "schedule",
            "important_date"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 200
        },
        "itinerary_details": {
          "$ref": "#/$defs/itineraryDetails"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "tracker_id": {
          "type": "string"
        },
        "record_values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "number": {
                "type": "number"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confidence"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tracker_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/trackerField"
          }
        },
        "tracker_ref": {
          "type": "string",
          "minLength": 1,
          "description": "本次新建 tracker 候选的 ref；与已有 tracker_id 互斥。"
        },
        "tracker_schedule": {
          "$ref": "#/$defs/trackerSchedule"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from_ref",
        "to_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "requires",
            "related_to"
          ]
        },
        "from_ref": {
          "type": "string",
          "minLength": 1
        },
        "to_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "blocking"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "blocking": {
          "type": "boolean",
          "description": "为 true 时 Capture 进入 awaiting_instruction，解析被阻塞。"
        },
        "quick_answers": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "options"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceSpan"
                }
              }
            }
          }
        }
      }
    },
    "trackerField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "required"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "number",
            "currency",
            "percentage",
            "duration",
            "text"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "trackerSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency"
      ],
      "properties": {
        "frequency": {
          "enum": [
            "daily",
            "weekly"
          ]
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "weekly"
              }
            }
          },
          "then": {
            "required": [
              "weekdays"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "daily"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "weekdays"
              ]
            }
          }
        }
      ]
    }
  }
}
