{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steward.local/ai-contracts/mood-journal/mood-journal-polish-result.v1.schema.json",
  "title": "Mood journal polish result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["content"],
  "properties": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "blocks"],
      "properties": {
        "format": {"const": "blocks_v1"},
        "version": {"const": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {"$ref": "#/$defs/block"}
        }
      }
    }
  },
  "$defs": {
    "marks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "strikethrough": {"type": "boolean"},
        "link": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "maxLength": 12000},
        "marks": {"$ref": "#/$defs/marks"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "runs"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "type": {
          "type": "string",
          "enum": ["paragraph", "heading_2", "heading_3", "bullet_item", "ordered_item", "quote", "divider"]
        },
        "runs": {
          "type": "array",
          "maxItems": 1,
          "items": {"$ref": "#/$defs/run"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "divider"}}, "required": ["type"]},
          "then": {"properties": {"runs": {"maxItems": 0}}},
          "else": {"properties": {"runs": {"minItems": 1}}}
        }
      ]
    }
  }
}
