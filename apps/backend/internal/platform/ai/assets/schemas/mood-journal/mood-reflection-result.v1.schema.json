{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steward.local/ai-contracts/mood-journal/mood-reflection-result.v1.schema.json",
  "title": "心情日记深度回望 v1",
  "description": "用户主动选择日记并单独同意后生成的结构化回望；所有观察必须引用本次选择范围内的日记。",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "observations", "reflection_questions", "gentle_suggestions"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "observations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_entry_ids"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_entry_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(mood|note)_[A-Za-z0-9_-]+$"
            }
          }
        }
      }
    },
    "reflection_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "gentle_suggestions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_entry_ids"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "source_entry_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(mood|note)_[A-Za-z0-9_-]+$"
            }
          }
        }
      }
    }
  }
}
