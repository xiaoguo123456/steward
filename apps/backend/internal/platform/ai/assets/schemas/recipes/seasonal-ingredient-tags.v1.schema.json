{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qhzhiyin.com/schemas/recipes/seasonal-ingredient-tags.v1.schema.json",
  "title": "菜谱时令食材标签批次",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ingredient_name", "normalized_name", "kind", "months", "reason"],
        "properties": {
          "ingredient_name": {"type": "string", "minLength": 1, "maxLength": 120},
          "normalized_name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {
            "type": "string",
            "enum": ["seasonal_fresh", "not_seasonal", "uncertain"]
          },
          "months": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 12}
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "seasonal_fresh"}}},
            "then": {"properties": {"months": {"minItems": 1}}},
            "else": {"properties": {"months": {"maxItems": 0}}}
          }
        ]
      }
    }
  }
}
