# 依赖与包管理器缓存
node_modules/
.pnpm-store/

# 构建、测试与本地输出
dist/
build/
coverage/
output/
.local/
*.apk
*.aab
*.log
*.tsbuildinfo

# OpenAPI bundle 是两端代码生成的唯一输入，也是可比较的契约快照，
# 必须入库：CI 才能在运行 make generate 后检查工作区是否漂移。
!packages/contracts/dist/
!packages/contracts/dist/openapi.bundle.yaml

# 本地环境与敏感配置
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example
local.properties
*.keystore
*.jks
*.p8
*.p12
*.pem
*.key
*.mobileprovision

# Expo 与 React Native 生成目录
.expo/
.metro-health-check*
apps/mobile/android/
apps/mobile/ios/

# 编辑器与操作系统文件
.DS_Store
.idea/
.vscode/
*.swp

# Go 本地测试产物
*.test
*.out

# 原始菜谱素材（11G+，含图片）。
# 图片走 OSS，结构化数据走导入脚本进库，两者都不该进版本库。
/菜谱数据/
/菜谱数据.zip

# 菜谱归档库（28M）。它由 archive.py 从上面那份素材重建。
# 不进版本库是因为：每次重新生成再提交都会永久增加 28M 历史，想删要改写历史。
# 需要长期留存时，它和 OSS 上的图片一起构成完整备份。
/tools/recipe-import/recipes.sqlite3*

# 后台前端构建产物
apps/admin/dist/
